# Generated live unit. Annotated sample: server.conf-dist
# TUN. Not 10.8.0.0/24 (other VPN).

port @PORT@
@LOCAL@
@PORT_SHARE@
proto @PROTO@
dev @DEV@
topology subnet

ca easy-rsa/pki/ca.crt
cert easy-rsa/pki/issued/@SERVER_CN@.crt
key easy-rsa/pki/private/@SERVER_CN@.key
dh none
tls-crypt tc.key
crl-verify crl.pem

server @POOL@
@SERVER_IPV6@
@IPP_PERSIST@
@DUPLICATE_CN@

@REDIRECT_GATEWAY_PUSH@
@REDIRECT_GATEWAY_IPV6_PUSH@
@LAN_ROUTE_PUSH@
@DNS_PUSH@
@BLOCK_OUTSIDE_DNS_PUSH@

keepalive 10 120
# clamp inner TCP MSS; do not use fragment (Android FRAG_IN errors)
mssfix @MSSFIX@

user nobody
group nogroup
persist-key
persist-tun

#verb 3
@EXIT_NOTIFY@
