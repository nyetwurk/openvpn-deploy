#!/usr/sbin/nft -f
#
# OpenVPN TUN forward + masquerade for a WAN-only VPS (no LAN).
# Not installed by `make deploy`. Copy server/openvpn.nft to
# /etc/nftables.d/openvpn.nft so `include "/etc/nftables.d/*.nft"`
# loads it after inet filter exists.
#   nft -f /etc/nftables.conf
# Standalone (inet filter must already exist):
#   nft -f /etc/nftables.d/openvpn.nft
#
# inet filter forward is policy drop. Accept must be in THAT chain;
# a drop there still wins. Do not add rule ip filter / ip nat —
# nftables.conf deletes those leftover iptables-nft tables.
# SNAT lives in table ip openvpn (delete then define so a second
# nft -f of this file is idempotent).
#
# Also: copy examples/99-openvpn-forward.conf to /etc/sysctl.d/
# (net.ipv4.ip_forward=1; sysctl, not nft).
# This file does not punch input. Host rfc1918_drop must be WAN-only
# (`iifname` the WAN); a global `ip saddr @@rfc1918_drop drop` also
# matches the VPN 10/8. Client → public net is forward + masquerade.
# Do not use on a NAT router that already has other forward rules.

define WAN_IF = @WAN_IF@
define VPN_IF = @VPN_IF@
define VPN_IPv4_NET = @VPN_IPV4_NET@

# This chain is otherwise empty. Flush so a second nft -f does not
# duplicate. Do not flush input (spam/rfc1918 live there).
flush chain inet filter forward
add rule inet filter forward iifname $WAN_IF oifname $VPN_IF ct state related,established accept
add rule inet filter forward oifname $WAN_IF ip saddr $VPN_IPv4_NET accept

table ip openvpn
delete table ip openvpn

table ip openvpn {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname $WAN_IF ip saddr $VPN_IPv4_NET masquerade
	}
}
